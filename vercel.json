{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd app && npm ci",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "https://www.sachinmaurya.com",
      "permanent": false
    }
  ]
}
